# ------------------------------------------------------------------
# Browser Extension Directory - environment variables
# Copy this file to `.env` and fill in your real Supabase credentials.
# Vite only exposes variables prefixed with VITE_ to the client.
# ------------------------------------------------------------------

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://pixreokymletbajiejmb.supabase.co

# Supabase public/anon API key
VITE_SUPABASE_ANON_KEY=sb_publishable_2CuYwKGL2UqAGSbv6mF2tw_Yh2FMQxy

# App-level config
VITE_APP_NAME=Extension Directory

# ------------------------------------------------------------------
# SECURITY — credential handling
# ------------------------------------------------------------------
# Only the PUBLIC anon key above may be exposed to the browser. Anything
# prefixed with VITE_ is bundled into the client and is public by design.
#
# NEVER put these in a VITE_ variable (or anywhere in this repo):
#   - SUPABASE_SERVICE_ROLE_KEY  (bypasses RLS — server / CI only)
#   - DB passwords / private keys
# The app is fully RLS-protected, so normal reads/writes need only the anon
# key. The service role key is reserved for trusted server-side jobs.
